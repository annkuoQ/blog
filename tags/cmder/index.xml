&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="n"&gt;C&lt;/span&gt;&lt;span class="p"&gt;:&lt;/span&gt;\&lt;span class="n"&gt;cmder&lt;/span&gt;\&lt;span class="n"&gt;vendor&lt;/span&gt;\&lt;span class="n"&gt;conemu&lt;/span&gt;&lt;span class="o"&gt;-&lt;/span&gt;&lt;span class="n"&gt;maximus5&lt;/span&gt;\&lt;span class="n"&gt;ConEmu&lt;/span&gt;\&lt;span class="n"&gt;ConEmuC&lt;/span&gt;&lt;span class="o"&gt;.&lt;/span&gt;&lt;span class="n"&gt;exe&lt;/span&gt;
